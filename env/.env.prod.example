# Production: accepted main release on a separate PostgreSQL instance; no seeds.
# Copy to env/.env.prod (ignored) and point the file paths at secrets of this environment; no passwords in Git.
DLC_ENVIRONMENT=prod
DLC_POSTGRES_HOST=dlc-postgres
DLC_POSTGRES_DB=di_lucca
DLC_PLATFORM_NETWORK=platform
DLC_LIQUIBASE_IMAGE=liquibase/liquibase:4.33.0
APPOINTMENTS_MIGRATOR_PASSWORD_FILE=../secrets/prod/appointments-migrator-password.txt
