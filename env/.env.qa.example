# QA: re-applied qa branch on its own PostgreSQL instance; synthetic test data only.
# Copy to env/.env.qa (ignored) and point the file paths at secrets of this environment; no passwords in Git.
DLC_ENVIRONMENT=qa
DLC_POSTGRES_HOST=dlc-postgres
DLC_POSTGRES_DB=di_lucca
DLC_PLATFORM_NETWORK=platform
DLC_LIQUIBASE_IMAGE=liquibase/liquibase:4.33.0
APPOINTMENTS_MIGRATOR_PASSWORD_FILE=../secrets/qa/appointments-migrator-password.txt
