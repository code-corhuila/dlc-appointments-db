# Development: integrated develop branch on its own PostgreSQL instance; synthetic data only.
# Copy to env/.env.dev (ignored) and point the file paths at secrets of this environment; no passwords in Git.
DLC_ENVIRONMENT=dev
DLC_POSTGRES_HOST=dlc-postgres
DLC_POSTGRES_DB=di_lucca
DLC_PLATFORM_NETWORK=platform
DLC_LIQUIBASE_IMAGE=liquibase/liquibase:4.33.0
APPOINTMENTS_MIGRATOR_PASSWORD_FILE=../secrets/dev/appointments-migrator-password.txt
